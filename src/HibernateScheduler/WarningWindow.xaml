<Window x:Class="HibernateScheduler.WarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hibernating soon" Width="330" SizeToContent="Height"
        WindowStyle="None" Background="{StaticResource Bg}" WindowChrome.WindowChrome="{StaticResource Chrome}"
        ResizeMode="NoResize" Topmost="True" ShowActivated="False" ShowInTaskbar="True" UseLayoutRounding="True">

    <Border Style="{StaticResource Card}" Padding="18,16">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource Moon}" Fill="{StaticResource Accent}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"/>
                <TextBlock x:Name="Headline" Text="Hibernating in 60s" FontWeight="SemiBold" FontSize="15" Margin="9,0,0,0"/>
            </StackPanel>
            <TextBlock x:Name="ReasonText" Foreground="{StaticResource Muted}" Margin="24,2,0,0"/>
            <ProgressBar x:Name="Bar" Style="{StaticResource Bar}" Margin="0,14"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource PrimaryBtn}" Content="Now" Padding="8,0" Click="Now_Click"/>
                <Button Grid.Column="2" Style="{StaticResource Btn}" Content="+15 min" Padding="8,0" Click="Snooze_Click"/>
                <Button Grid.Column="4" Style="{StaticResource DangerBtn}" Content="Cancel" Padding="8,0" Click="Cancel_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
