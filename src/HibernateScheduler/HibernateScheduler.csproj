<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms only for the tray NotifyIcon and SetSuspendState -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <!-- Off: WPF and WinForms implicit usings collide (Application, Button, ...) -->
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>HibernateScheduler</RootNamespace>
    <AssemblyName>HibernateScheduler</AssemblyName>
    <Version>1.1.0</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Product>Hibernate Scheduler</Product>
    <Company>noissaPStudio</Company>
  </PropertyGroup>

</Project>
