<Window x:Class="HibernateScheduler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hibernate Scheduler" Width="348" SizeToContent="Height"
        WindowStyle="None" Background="{StaticResource Bg}" WindowChrome.WindowChrome="{StaticResource Chrome}"
        ResizeMode="NoResize" ShowInTaskbar="True" UseLayoutRounding="True">

    <Border Style="{StaticResource Card}" Padding="18,12,18,18">
        <StackPanel>

            <!-- ==========================================
                 HEADER
                 ========================================== -->
            <Grid Background="Transparent" Margin="0,0,-8,14" MouseLeftButtonDown="Header_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource Moon}" Fill="{StaticResource Accent}" Width="15" Height="15" Stretch="Uniform"/>
                    <TextBlock x:Name="TitleText" Text="Hibernate" FontWeight="SemiBold" FontSize="14" Margin="9,0,0,0"/>
                    <Ellipse x:Name="RemoteDot" Width="6" Height="6" Fill="{StaticResource Good}" Margin="8,1,0,0"
                             Visibility="Collapsed" ToolTip="Remote trigger is on"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SettingsBtn" Style="{StaticResource IconBtn}" Content="&#xE713;" ToolTip="Settings" Click="Settings_Click"/>
                    <Button Style="{StaticResource IconBtn}" Content="&#xE8BB;" FontSize="10" ToolTip="Hide to tray" Click="Hide_Click"/>
                </StackPanel>
            </Grid>

            <!-- ==========================================
                 SET A HIBERNATE
                 ========================================== -->
            <StackPanel x:Name="SetPanel">
                <Border Background="{StaticResource Surface}" CornerRadius="9" Padding="3">
                    <UniformGrid Columns="2">
                        <RadioButton x:Name="ModeIn" Style="{StaticResource Segment}" Content="After a while" GroupName="mode" IsChecked="True" Checked="Mode_Changed"/>
                        <RadioButton x:Name="ModeAt" Style="{StaticResource Segment}" Content="At a time" GroupName="mode" Checked="Mode_Changed"/>
                    </UniformGrid>
                </Border>

                <!-- After a while -->
                <StackPanel x:Name="InPanel" Margin="0,12,0,0">
                    <UniformGrid x:Name="Chips" Columns="3" Margin="-3"/>
                    <!-- Same 6px gutter as the chips so the outer edges line up -->
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource UnitBox}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="Hours" Style="{StaticResource BareField}" Text="0" TextChanged="Input_Changed"/>
                                <TextBlock Grid.Column="1" Text="hr" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource UnitBox}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="Minutes" Style="{StaticResource BareField}" Text="30" TextChanged="Input_Changed"/>
                                <TextBlock Grid.Column="1" Text="min" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- At a time -->
                <StackPanel x:Name="AtPanel" Margin="0,12,0,0" Visibility="Collapsed">
                    <TextBox x:Name="AtTime" Style="{StaticResource Field}" Text="23:00" FontSize="30" FontFamily="{StaticResource DisplayFont}"
                             HorizontalContentAlignment="Center" Padding="8,6" Height="Auto" TextChanged="Input_Changed"/>
                    <TextBlock Text="24-hour time, e.g. 22:30" Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>

                <TextBlock x:Name="Preview" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,14,0,12"/>
                <Button x:Name="SetBtn" Style="{StaticResource PrimaryBtn}" Content="Set hibernate" Click="Set_Click"/>
                <Button Style="{StaticResource GhostBtn}" Content="Hibernate now" HorizontalAlignment="Center" Margin="0,8,0,-6" Click="Now_Click"/>
            </StackPanel>

            <!-- ==========================================
                 PENDING
                 ========================================== -->
            <StackPanel x:Name="ActivePanel" Visibility="Collapsed">
                <TextBlock Text="Hibernating in" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="Remaining" Text="0:30:00" FontSize="46" FontWeight="Light" FontFamily="{StaticResource DisplayFont}"
                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
                <TextBlock x:Name="TargetText" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,0,0,18"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ExtendBtn" Style="{StaticResource Btn}" Content="+15 min" Click="Extend_Click"/>
                    <Button Grid.Column="2" Style="{StaticResource DangerBtn}" Content="Cancel" Click="Cancel_Click"/>
                </Grid>
            </StackPanel>

            <!-- ==========================================
                 SETTINGS
                 ========================================== -->
            <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
                <CheckBox x:Name="StartupSwitch" Style="{StaticResource Switch}" Content="Start with Windows" Click="Startup_Click"/>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Warning before hibernating" VerticalAlignment="Center"/>
                    <TextBox x:Name="WarnSeconds" Grid.Column="1" Style="{StaticResource Field}" HorizontalContentAlignment="Center" Padding="4,0" LostFocus="WarnSeconds_LostFocus"/>
                    <TextBlock Grid.Column="2" Text="sec" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>

                <Border Height="1" Background="{StaticResource Stroke}" Margin="0,16"/>

                <CheckBox x:Name="RemoteSwitch" Style="{StaticResource Switch}" Content="Remote trigger via OneDrive" Click="Remote_Click"/>
                <StackPanel x:Name="RemoteDetails" Margin="0,10,0,0">
                    <Border Background="{StaticResource Surface}" CornerRadius="8" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="RemotePath" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Style="{StaticResource IconBtn}" Content="&#xE838;" ToolTip="Open folder" Margin="4,-4,0,-4" Click="OpenFolder_Click"/>
                            <Button Grid.Column="2" Style="{StaticResource IconBtn}" Content="&#xE70F;" ToolTip="Change OneDrive location" Margin="0,-4,-6,-4" Click="ChangeFolder_Click"/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="RemoteHelp" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="2,10,0,0" LineHeight="18"/>
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
